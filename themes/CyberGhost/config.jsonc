{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " > ",
    "color": {
      "separator": "green"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "▓  USER  ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐",
      "outputColor": "green"
    },
    {
      "type": "os",
      "key": "│ 󰣇 OS     ",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "│  Kernel ",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "│ 󱫐 Uptime ",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────┤",
      "outputColor": "cyan"
    },
    {
      "type": "wm",
      "key": "│ 󱗃 WM     ",
      "keyColor": "cyan",
      "format": "{2}"
    },
    {
      "type": "terminal",
      "key": "│  Term   ",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "│  Shell  ",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display",
      "keyColor": "cyan",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────┤",
      "outputColor": "green"
    },
    {
      "type": "cpu",
      "key": "│  CPU    ",
      "keyColor": "green",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "│ 󰊴 GPU    ",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "│ 󰘚 RAM    ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 Disk   ",
      "keyColor": "green",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "│ 󰩟 IP     ",
      "keyColor": "cyan",
      "showIpv6": false,
      "showMac": false
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
      "outputColor": "green"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
